{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Passive JFR metrics (opensabe.jfr.metrics). Empty panels usually mean process JFR event not enabled or repository not attached — check jfr_metrics_repository_attached / jfr_metrics_event_seen.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Repository attached",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "jfr_metrics_repository_attached",
          "legendFormat": "attached",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Alloc sample weight by class (Top)",
      "type": "table",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "topk(20, jfr_alloc_sample_weight_bytes_by_class)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "title": "Alloc sample weight by method (Top)",
      "type": "table",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "topk(20, jfr_alloc_sample_weight_bytes_by_method)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "title": "Old object samples by class",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "topk(20, jfr_old_object_samples_by_class)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "title": "Old object global heap (lastKnownHeapUsage)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "jfr_old_object_heap_bytes",
          "legendFormat": "heap",
          "refId": "A"
        }
      ]
    },
    {
      "title": "CPU hot methods (ExecutionSample)",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "targets": [
        {
          "expr": "topk(20, jfr_execution_samples_by_method)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "title": "Lock wait (ms → /1000 for seconds)",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "targets": [
        {
          "expr": "topk(20, jfr_monitor_enter_wait_milliseconds)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "title": "Outside TLAB by class (optional; needs process jfc)",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "targets": [
        {
          "expr": "topk(20, jfr_outside_tlab_bytes_by_class)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "title": "Allocation requiring GC by method (optional)",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "targets": [
        {
          "expr": "topk(20, jfr_alloc_requiring_gc_bytes_by_method)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["jfr", "opensabe"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "JFR Runtime (passive consumer)",
  "uid": "opensabe-jfr-runtime",
  "version": 1
